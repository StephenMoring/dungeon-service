# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.
# Then: chmod 600 .env   so only your user can read it.

# Your domain, without https://. Its DNS A record must point at this server.
SITE_ADDRESS=play.example.com

# Database login, used only inside the Compose network. Use a long random password:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_USER=dungeon
POSTGRES_PASSWORD=

# Signs sessions and character previews. At least 32 bytes; the API won't start
# otherwise. Changing it signs everyone out.
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# API keys. Set a monthly spend limit for each in its console.
DUNGEON_ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# From the Discord developer portal (your application > OAuth2). Add
# https://SITE_ADDRESS/auth/callback as a redirect there.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
